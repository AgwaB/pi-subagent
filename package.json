{
  "name": "@agwab/pi-subagent",
  "version": "0.5.1",
  "description": "Minimal subagent runtime for Pi.",
  "type": "module",
  "private": false,
  "keywords": [
    "pi-package",
    "pi",
    "subagent",
    "agent",
    "sandbox"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts",
    "./api": {
      "types": "./src/api.ts",
      "default": "./api.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "api.mjs",
    "src",
    "docs",
    "assets",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/AgwaB/pi-subagent/main/assets/subagent-panel.png"
  },
  "scripts": {
    "build:native:darwin": "node ./scripts/build-darwin-process-identity.mjs",
    "check:scripts": "for d in scripts test src/workers; do [ -d \"$d\" ] && find \"$d\" -name '*.mjs' -print; done | xargs -n1 node --check",
    "check:resolver": "node ./test/checks/resolver.mjs",
    "check:api": "node ./test/checks/api.mjs",
    "check:artifacts": "node ./test/checks/artifacts.mjs",
    "check:parent-session": "node ./test/checks/parent-session.mjs",
    "check:panel-session-scope": "node ./test/checks/panel-session-scope.mjs",
    "check:contracts": "node ./test/checks/contracts.mjs",
    "check:agents": "node ./test/checks/agents.mjs",
    "check:no-chain": "node ./test/checks/no-chain.mjs",
    "check:panel": "node ./test/checks/panel.mjs",
    "check:worktree-cleanup": "node ./test/checks/worktree-cleanup.mjs",
    "check:workspace-policy": "node ./test/checks/workspace-policy.mjs",
    "check:lifecycle": "node ./test/checks/lifecycle.mjs",
    "check:fail-fast": "node ./test/checks/fail-fast.mjs",
    "check:schema-sync": "node ./test/checks/schema-sync.mjs",
    "check:run-lock": "node ./test/checks/run-lock.mjs",
    "check:darwin-process-identity": "node ./test/checks/darwin-process-identity-helper.mjs",
    "check:release-workflow": "node ./test/checks/release-workflow.mjs",
    "check:release-version": "node ./test/checks/release-version.mjs",
    "check:reconcile": "node ./test/checks/reconcile.mjs",
    "check:tmux-ownership": "node ./test/checks/tmux-ownership.mjs",
    "check:inline-sdk-compat": "node ./test/checks/inline-sdk-compat.mjs",
    "check:headless-streaming": "node ./test/checks/headless-streaming.mjs",
    "check:usage-accumulation": "node ./test/checks/usage-accumulation.mjs",
    "check:tool-result-budget": "node ./test/checks/tool-result-budget.mjs",
    "check:durable-launch-barrier": "node ./test/checks/durable-launch-barrier.mjs",
    "check:durable-worker-binding": "node ./test/checks/durable-worker-binding.mjs",
    "check:durable-worker-preflight": "node ./test/checks/durable-worker-preflight.mjs",
    "check:durable-worker-payload": "node ./test/checks/durable-worker-payload.mjs",
    "check:sandbox-agent-locks": "node ./test/checks/sandbox-agent-locks.mjs",
    "check:run-locator-sweep": "node ./test/checks/run-locator-sweep.mjs",
    "check:prune": "node ./test/checks/prune.mjs",
    "check:model:inline": "node ./test/integration/inline-model.mjs",
    "check:model:headless": "node ./test/integration/headless-model.mjs",
    "check:model:tmux": "node ./test/integration/tmux-model.mjs",
    "check:all": "npm run check:static && npm run check:integration",
    "validate": "npm run check:scripts && npm run check:static",
    "release:check": "node ./scripts/release-check.mjs",
    "check": "npm run check:static",
    "check:types": "tsc -p tsconfig.json",
    "check:static": "npm run check:types && npm run check:api && npm run check:resolver && npm run check:artifacts && npm run check:parent-session && npm run check:panel-session-scope && npm run check:contracts && npm run check:agents && npm run check:no-chain && npm run check:panel && npm run check:worktree-cleanup && npm run check:workspace-policy && npm run check:lifecycle && npm run check:fail-fast && npm run check:schema-sync && npm run check:run-lock && npm run check:darwin-process-identity && npm run check:release-workflow && npm run check:release-version && npm run check:reconcile && npm run check:tmux-ownership && npm run check:inline-sdk-compat && npm run check:headless-streaming && npm run check:usage-accumulation && npm run check:tool-result-budget && npm run check:durable-launch-barrier && npm run check:durable-worker-binding && npm run check:durable-worker-preflight && npm run check:durable-worker-payload && npm run check:sandbox-agent-locks && npm run check:run-locator-sweep && npm run check:prune",
    "check:integration": "npm run check:model:inline && npm run check:model:headless && npm run check:model:tmux"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.54",
    "jiti": "^2.7.0",
    "proper-lockfile": "^4.1.2",
    "typebox": "^1.3.25"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.4",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@earendil-works/pi-tui": "^0.84.4",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": false
    },
    "@earendil-works/pi-coding-agent": {
      "optional": false
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgwaB/pi-subagent.git"
  },
  "homepage": "https://github.com/AgwaB/pi-subagent#readme",
  "bugs": {
    "url": "https://github.com/AgwaB/pi-subagent/issues"
  }
}
